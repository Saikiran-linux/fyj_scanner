node_modules/
.env
.env.local
.env.*.local
*.log
.DS_Store
data/probe-results.jsonl
data/last-scan-state.json
# Per-run audit artefact from src/recover-greenhouse-slugs.mjs (timestamped,
# regenerated every run — like a log, not source data).
data/recover-greenhouse-report.json

# Session-scratch artefacts (embedding dumps, match results, ad-hoc SQL).
# Anything in scripts/ prefixed with _ is throwaway; named scripts are tracked.
scripts/_*

# Tailor outputs and fixtures — generated resumes contain PII and per-job
# drafts shouldn't churn the repo. Underscore-prefixed files are local
# fixtures (master resumes, JD samples); the rest are generator outputs.
output/tailored/
output/rendered/

# local benchmark output (regenerated by scripts/matching-bench.mjs)
scripts/_bench-results.json

# Agent skill tooling (installed via `npx skills add ...`; lives with the
# ops-console repo, not the scanner). Local-only; re-add when needed.
.agents/
.claude/skills/
skills-lock.json

# Claude Code agent worktrees. These are local git worktrees, not source —
# they were previously committed by accident as bare gitlinks (mode 160000)
# with no .gitmodules, which made `git`/CI emit "No url found for submodule
# path '.claude/worktrees/…'" and exit 128. Ignore the whole dir so they
# never get re-committed.
.claude/worktrees/
