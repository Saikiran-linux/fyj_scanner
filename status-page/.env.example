# Required. Same values used by the scanner.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_eyJ_...

# The service-role key never reaches the browser — only Server Components
# in app/page.jsx read it. If you'd rather use the anon key, you'll need
# read-only RLS policies on the views first.
