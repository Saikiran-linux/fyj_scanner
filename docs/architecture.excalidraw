    { "id": "d_label", "type": "text", "x": 80, "y": 1430, "width": 600, "height": 36, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 240, "version": 1, "versionNonce": 240, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 26, "fontFamily": 1, "text": "D · Multi-agent CV-tailor pipeline", "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "D · Multi-agent CV-tailor pipeline", "lineHeight": 1.25 },
