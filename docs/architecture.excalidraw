    { "id": "b_pick", "type": "rectangle", "x": 420, "y": 570, "width": 280, "height": 110, "angle": 0, "strokeColor": "#f59f00", "backgroundColor": "#3f2f1a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b2"], "frameId": null, "roundness": {"type": 3}, "seed": 90, "version": 1, "versionNonce": 90, "isDeleted": false, "boundElements": [{"id": "b_pick_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
