    { "id": "b_a4_lbl", "type": "text", "x": 1140, "y": 690, "width": 220, "height": 18, "angle": 0, "strokeColor": "#74c0fc", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 154, "version": 1, "versionNonce": 154, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 1, "text": "PostgREST upsert", "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "PostgREST upsert", "lineHeight": 1.25 },
