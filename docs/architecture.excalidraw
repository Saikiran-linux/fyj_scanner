    { "id": "c_label", "type": "text", "x": 80, "y": 1010, "width": 600, "height": 36, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 160, "version": 1, "versionNonce": 160, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 26, "fontFamily": 1, "text": "C · Per-user matching pipeline", "textAlign": "left", "verticalAlign": "top", "baseline": 22, "containerId": null, "originalText": "C · Per-user matching pipeline", "lineHeight": 1.25 },
    { "id": "c_sub", "type": "text", "x": 80, "y": 1050, "width": 1400, "height": 22, "angle": 0, "strokeColor": "#adb5bd", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 161, "version": 1, "versionNonce": 161, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 15, "fontFamily": 1, "text": "Daily cron per user.  SQL filter (free) → Haiku triage ($0.005) → matches inbox → on-demand Sonnet A–G report ($0.15) → multi-agent CV tailor (§ D).", "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "Daily cron per user.  SQL filter (free) → Haiku triage ($0.005) → matches inbox → on-demand Sonnet A–G report ($0.15) → multi-agent CV tailor (§ D).", "lineHeight": 1.25 },

    { "id": "c_profile", "type": "rectangle", "x": 100, "y": 1100, "width": 260, "height": 130, "angle": 0, "strokeColor": "#51cf66", "backgroundColor": "#163a1c", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c1"], "frameId": null, "roundness": {"type": 3}, "seed": 170, "version": 1, "versionNonce": 170, "isDeleted": false, "boundElements": [{"id": "c_profile_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "c_profile_lbl", "type": "text", "x": 115, "y": 1115, "width": 230, "height": 100, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c1"], "frameId": null, "roundness": null, "seed": 171, "version": 1, "versionNonce": 171, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 1, "text": "User profile\ntarget_titles[], locations\ncomp_floor, seniority\ndeal_breakers, archetypes\nfeedback_signals", "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": "c_profile", "originalText": "User profile", "lineHeight": 1.25 },

    { "id": "c_sql", "type": "rectangle", "x": 400, "y": 1100, "width": 300, "height": 230, "angle": 0, "strokeColor": "#74c0fc", "backgroundColor": "#0f2a44", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c2"], "frameId": null, "roundness": {"type": 3}, "seed": 180, "version": 1, "versionNonce": 180, "isDeleted": false, "boundElements": [{"id": "c_sql_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "c_sql_lbl", "type": "text", "x": 415, "y": 1115, "width": 270, "height": 200, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c2"], "frameId": null, "roundness": null, "seed": 181, "version": 1, "versionNonce": 181, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 1, "text": "Stage 1 — SQL filter\nfree, sub-second\n\nWHERE active = true\n  AND posted_at > now()-'30 days'\n  AND title ~* user.title_patterns\n  AND (loc IN user.locs OR remote_ok)\n  AND comp_max >= user.comp_floor\n  AND company NOT IN blocklist\n\n→ 50–200 candidates / user / day", "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": "c_sql", "originalText": "Stage 1 — SQL filter", "lineHeight": 1.25 },

    { "id": "c_haiku", "type": "rectangle", "x": 740, "y": 1100, "width": 300, "height": 230, "angle": 0, "strokeColor": "#15aabf", "backgroundColor": "#0d3338", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c3"], "frameId": null, "roundness": {"type": 3}, "seed": 190, "version": 1, "versionNonce": 190, "isDeleted": false, "boundElements": [{"id": "c_haiku_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "c_haiku_lbl", "type": "text", "x": 755, "y": 1115, "width": 270, "height": 200, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c3"], "frameId": null, "roundness": null, "seed": 191, "version": 1, "versionNonce": 191, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 1, "text": "Stage 2 — Haiku triage\n~$0.005 per candidate\n\nclaude-haiku-4-5\ncached system prompt:\n  user profile + scoring rubric\nvar input:\n  title + first 800 chars JD\nout: { score 1–5, reason }\n\n→ 10–30 ≥ 3.5 / user / day", "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": "c_haiku", "originalText": "Stage 2 — Haiku triage", "lineHeight": 1.25 },

    { "id": "c_inbox", "type": "rectangle", "x": 1080, "y": 1100, "width": 300, "height": 230, "angle": 0, "strokeColor": "#51cf66", "backgroundColor": "#163a1c", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c4"], "frameId": null, "roundness": {"type": 3}, "seed": 200, "version": 1, "versionNonce": 200, "isDeleted": false, "boundElements": [{"id": "c_inbox_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "c_inbox_lbl", "type": "text", "x": 1095, "y": 1115, "width": 270, "height": 200, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c4"], "frameId": null, "roundness": null, "seed": 201, "version": 1, "versionNonce": 201, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 1, "text": "Stage 3 — Inbox\n\ninsert matches row\n  (user_id, job_id,\n   triage_score, reason)\n\nuser_action enum:\n  saved | dismissed | evaluated\n\ndaily digest email\n  (Resend + React Email)\n  at user-configured time", "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": "c_inbox", "originalText": "Stage 3 — Inbox", "lineHeight": 1.25 },

    { "id": "c_sonnet", "type": "rectangle", "x": 1420, "y": 1100, "width": 300, "height": 230, "angle": 0, "strokeColor": "#f59f00", "backgroundColor": "#3f2f1a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c5"], "frameId": null, "roundness": {"type": 3}, "seed": 210, "version": 1, "versionNonce": 210, "isDeleted": false, "boundElements": [{"id": "c_sonnet_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "c_sonnet_lbl", "type": "text", "x": 1435, "y": 1115, "width": 270, "height": 200, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c5"], "frameId": null, "roundness": null, "seed": 211, "version": 1, "versionNonce": 211, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 1, "text": "Stage 4 — Deep eval (on-demand)\nuser clicks 'evaluate'\n\nclaude-sonnet-4-6\nfull A–G report\n(role fit, exp gap, comp,\n location, growth, risks,\n verdict)\n\n~$0.15 with prompt caching\nwrite reports row\ntriggers § D tailor pipeline", "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": "c_sonnet", "originalText": "Stage 4 — Deep eval", "lineHeight": 1.25 },

    { "id": "c_fb", "type": "rectangle", "x": 1760, "y": 1100, "width": 280, "height": 230, "angle": 0, "strokeColor": "#cc5de8", "backgroundColor": "#3a1f3f", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["c6"], "frameId": null, "roundness": {"type": 3}, "seed": 220, "version": 1, "versionNonce": 220, "isDeleted": false, "boundElements": [{"id": "c_fb_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "c_fb_lbl", "type": "text", "x": 1775, "y": 1115, "width": 250, "height": 200, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c6"], "frameId": null, "roundness": null, "seed": 221, "version": 1, "versionNonce": 221, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 1, "text": "Feedback loop (planned)\nthumbs ↑↓ on matches\n→ feedback row\n→ profile editor proposes\n   target_title / archetype\n   tweaks (LLM-drafted,\n   user-approved)\n\npattern analysis port from\nmodes/oferta.md", "textAlign": "left", "verticalAlign": "top", "baseline": 11, "containerId": "c_fb", "originalText": "Feedback loop", "lineHeight": 1.25 },

    { "id": "c_a1", "type": "arrow", "x": 360, "y": 1215, "width": 40, "height": 0, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 230, "version": 1, "versionNonce": 230, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "startArrowhead": null, "endArrowhead": "arrow", "points": [[0, 0], [40, 0]] },
