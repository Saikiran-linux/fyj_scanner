    { "id": "b_db", "type": "rectangle", "x": 1420, "y": 570, "width": 380, "height": 340, "angle": 0, "strokeColor": "#74c0fc", "backgroundColor": "#0f2a44", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b6"], "frameId": null, "roundness": {"type": 3}, "seed": 130, "version": 1, "versionNonce": 130, "isDeleted": false, "boundElements": [{"id": "b_db_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "b_db_lbl", "type": "text", "x": 1435, "y": 585, "width": 350, "height": 310, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b6"], "frameId": null, "roundness": null, "seed": 131, "version": 1, "versionNonce": 131, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 1, "text": "Postgres   (Supabase today · Neon planned)\n\ncompanies         ats, slug, probe_url\n                  enabled, consecutive_errors\njobs              external_id, title, location\n                  description, description_summary\n                  embedding vector(1536) + HNSW\n                  first_seen / last_seen / closed_at\n                  fingerprint, source_*\nscans             status, totals, notes\nprobe_results     http_status, latency, blocked\nscan_sources      (planned) per-source priority\n\ntriggers:\n• invalidate_embedding_on_desc_change\n• pgrst_watch_ddl  (schema reload)\nviews/MVs: v_active_jobs · v_unique_active_jobs\nv_source_health_24h · mv_jobs_totals_by_source", "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": "b_db", "originalText": "Postgres", "lineHeight": 1.25 },

