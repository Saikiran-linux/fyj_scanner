    { "id": "b_worker", "type": "rectangle", "x": 740, "y": 570, "width": 300, "height": 200, "angle": 0, "strokeColor": "#f59f00", "backgroundColor": "#3f2f1a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b3"], "frameId": null, "roundness": {"type": 3}, "seed": 100, "version": 1, "versionNonce": 100, "isDeleted": false, "boundElements": [{"id": "b_worker_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "b_worker_lbl", "type": "text", "x": 755, "y": 585, "width": 270, "height": 170, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b3"], "frameId": null, "roundness": null, "seed": 101, "version": 1, "versionNonce": 101, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 1, "text": "Scan worker pool\nSCAN_WORKER_POOL = 10\n\n• providers.fetchJobs(slug)\n• parse → normalise → fingerprint\n• providers.fetchJobDescription\n   (cap 500/scan, SR-only)\n• upsert jobs\n• insert probe_results\n• bump consecutive_errors", "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": "b_worker", "originalText": "Scan worker pool\nSCAN_WORKER_POOL = 10\n\n• providers.fetchJobs(slug)\n• parse → normalise → fingerprint\n• providers.fetchJobDescription\n   (cap 500/scan, SR-only)\n• upsert jobs\n• insert probe_results\n• bump consecutive_errors", "lineHeight": 1.25 },

    { "id": "b_rl", "type": "rectangle", "x": 1080, "y": 570, "width": 300, "height": 200, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#3a2010", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b4"], "frameId": null, "roundness": {"type": 3}, "seed": 110, "version": 1, "versionNonce": 110, "isDeleted": false, "boundElements": [{"id": "b_rl_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
    { "id": "b_rl_lbl", "type": "text", "x": 1095, "y": 585, "width": 270, "height": 170, "angle": 0, "strokeColor": "#e9ecef", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b4"], "frameId": null, "roundness": null, "seed": 111, "version": 1, "versionNonce": 111, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 1, "text": "Adaptive rate limiter\nper-source conc + interval\n\n• rolling 20-req block-rate\n• >5% blocked → halve conc,\n   2× interval\n• <1% → ramp back\n• honours 429 Retry-After\nGH 10·0ms · Ashby 3·200ms\nLever 5·100ms · SR 3·100ms", "textAlign": "left", "verticalAlign": "top", "baseline": 12, "containerId": "b_rl", "originalText": "Adaptive rate limiter\nper-source conc + interval\n\n• rolling 20-req block-rate\n• >5% blocked → halve conc,\n   2× interval\n• <1% → ramp back\n• honours 429 Retry-After\nGH 10·0ms · Ashby 3·200ms\nLever 5·100ms · SR 3·100ms", "lineHeight": 1.25 },

    { "id": "b_close", "type": "rectangle", "x": 740, "y": 800, "width": 300, "height": 110, "angle": 0, "strokeColor": "#f59f00", "backgroundColor": "#3f2f1a", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["b5"], "frameId": null, "roundness": {"type": 3}, "seed": 120, "version": 1, "versionNonce": 120, "isDeleted": false, "boundElements": [{"id": "b_close_lbl", "type": "text"}], "updated": 1, "link": null, "locked": false },
